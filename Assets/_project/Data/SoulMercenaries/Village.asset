  - Kind: 1
    Name: "\uC0C1\uC810"
    Description: "\uC7A5\uBE44\xB7\uC601\uD63C\uC11D\xB7\uD68C\uBCF5 \uD3EC\uC158\uC744
      \uC0AC\uACE0, \uC4F0\uC9C0 \uC54A\uB294 \uC7A5\uBE44\uB97C \uD31D\uB2C8\uB2E4."
