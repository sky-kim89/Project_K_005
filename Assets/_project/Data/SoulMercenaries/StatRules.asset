  UpperStatInfo:
  - Id: 16
    DisplayName: "\uADFC\uB825"
    Description: "\uBB3C\uB9AC \uACF5\uACA9\uB825\uACFC \uBC00\uCE58\uAE30 \uAC15\uB3C4,
      \uBB34\uAC70\uC6B4 \uBB34\uAE30\uC758 \uD6A8\uC728\uC744 \uC62C\uB9BD\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: c72ad449a9105914e8ed46cc85405848, type: 3}
    Color: {r: 0.9, g: 0.4, b: 0.3, a: 1}
  - Id: 17
    DisplayName: "\uCCB4\uB825"
    Description: "\uCD5C\uB300 HP, \uCD5C\uB300 \uC2A4\uD0DC\uBBF8\uB098, \uC2A4\uD0DC\uBBF8\uB098
      \uC7AC\uC0DD, \uC2E0\uCCB4 \uC0C1\uD0DC\uC774\uC0C1 \uC800\uD56D\uC744 \uC62C\uB9BD\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: 715c1e6e96be8e1468c6c40007982fd3, type: 3}
    Color: {r: 0.4, g: 0.85, b: 0.4, a: 1}
  - Id: 18
    DisplayName: "\uBBFC\uCCA9"
    Description: "\uD589\uB3D9 \uC18D\uB3C4, \uC774\uB3D9 \uC18D\uB3C4, \uBA85\uC911\uACFC
      \uD68C\uD53C\uB97C \uC62C\uB9BD\uB2C8\uB2E4. \uB454\uD654\uC5D0 \uBC84\uD301\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: 3efb50d6018b47241b6c7ccb781d6481, type: 3}
    Color: {r: 0.5, g: 0.8, b: 0.9, a: 1}
  - Id: 19
    DisplayName: "\uB9C8\uB825"
    Description: "\uB9C8\uBC95 \uD53C\uD574\uC640 \uCD5C\uB300 MP, \uB9C8\uBC95 \uD6A8\uACFC\uB7C9\uC744
      \uC62C\uB9BD\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: 15c092f3499b08840a2c4c6dde0e07a8, type: 3}
    Color: {r: 0.7, g: 0.5, b: 0.95, a: 1}
  - Id: 20
    DisplayName: "\uC815\uC2E0\uB825"
    Description: "\uACF5\uD3EC\xB7\uD63C\uB780\xB7\uC2A4\uD134\xB7\uC11D\uD654\uC5D0
      \uBC84\uD2F0\uACE0 \uADF8 \uB4F1\uAE09\uC744 \uB0AE\uCDA5\uB2C8\uB2E4. \uC9C0\uCCD0
      \uC4F0\uB7EC\uC9C0\uB294 \uB2E4\uC6B4\uC5D0\uB3C4 \uBC84\uD301\uB2C8\uB2E4.
      \uB192\uC744\uC218\uB85D \uAC15\uD55C \uC801\uC758 \uC704\uC555\uAC10\uC5D0
      \uAC81\uBA39\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB3D9\uB8CC\uC758 \uC8FD\uC74C\uC774\uB098
      \uB9CE\uC740 \uCC98\uCE58\uB97C \uACAA\uC73C\uBA74 \uC804\uD22C \uD6C4 \uC131\uC7A5\uD569\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: eaf2b1b976d1ee74895f7028302499e8, type: 3}
    Color: {r: 0.95, g: 0.85, b: 0.5, a: 1}
  - Id: 21
    DisplayName: "\uC6B4"
    Description: "\uD655\uB960\uD615 \uC2A4\uD0AC\uACFC \uB4DC\uBB38 \uBC1C\uB3D9\uC744
      \uBCF4\uC815\uD569\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: f6f2e27d68bcf3e4782a13db7c2adae5, type: 3}
    Color: {r: 1, g: 0.85, b: 0.3, a: 1}
  - Id: 22
    DisplayName: "\uC7AC\uC0DD\uB825"
    Description: "\uCD08\uB2F9 HP\uB97C \uC7AC\uC0DD\uD569\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: 352bbb23f43da464bbd521259396d8ab, type: 3}
    Color: {r: 0.45, g: 0.9, b: 0.55, a: 1}
  - Id: 23
    DisplayName: "\uB0B4\uAD6C\uB3C4"
    Description: "\uBC29\uC5B4\uB825\uACFC \uBB3C\uB9AC \uB0B4\uC131, \uC704\uD611\uB3C4\uB97C
      \uC62C\uB9BD\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: d2d774a0fabcb7d4fa55634b276b84a2, type: 3}
    Color: {r: 0.72, g: 0.76, b: 0.84, a: 1}
  - Id: 24
    DisplayName: "\uD56D\uB9C8\uB825"
    Description: "\uB9C8\uBC95 \uB0B4\uC131\uC744 \uC62C\uB824 \uB9C8\uBC95 \uD53C\uD574\uB97C
      \uC904\uC785\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: fe890464873aee049905a463d6011e13, type: 3}
    Color: {r: 0.9, g: 0.45, b: 0.85, a: 1}
  - Id: 25
    DisplayName: "\uD68C\uBCF5\uB825"
    Description: "MP \uD68C\uBCF5 \uC18D\uB3C4\uB97C \uD06C\uAC8C, \uC2A4\uD0DC\uBBF8\uB098
      \uD68C\uBCF5 \uC18D\uB3C4\uB97C \uC870\uAE08 \uC62C\uB9BD\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: cd137da7b1675044487de167b580e078, type: 3}
    Color: {r: 0.35, g: 0.85, b: 0.85, a: 1}
  - Id: 26
    DisplayName: "\uC808\uC0AD\uB825"
    Description: "\uBCA0\uAE30\xB7\uAC80 \uACC4\uC5F4 \uD53C\uD574\uC640 \uADF8 \uACF5\uACA9\uC758
      \uBC29\uC5B4 \uAD00\uD1B5\uC744 \uC62C\uB9BD\uB2C8\uB2E4."
    Icon: {fileID: 21300000, guid: 4ff5085c5eaa0a2408ddd4e5917aac70, type: 3}
    Color: {r: 0.95, g: 0.38, b: 0.38, a: 1}
  - Id: 27
    DisplayName: "\uD0C0\uACA9\uB825"
    Description: "\uD718\uB450\uB974\uAE30\xB7\uB454\uAE30\xB7\uCDA9\uACA9\uD30C
      \uD53C\uD574\uC640 \uACBD\uC9C1(\uC2A4\uD134) \uD655\uB960\uC744 \uC62C\uB9BD\uB2C8\uB2E4."
